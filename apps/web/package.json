{
  "name": "@prolang/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun ../../scripts/supervise.ts bun --bun vite dev --host 0.0.0.0",
    "build": "bun --bun vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "start": "bun build/index.js",
    "test:e2e": "bun run build && playwright test"
  },
  "dependencies": {
    "@sveltejs/kit": "2.48.5",
    "svelte": "5.43.8",
    "vite": "6.4.1",
    "svelte-adapter-bun": "1.0.1",
    "ts-fsrs": "5.2.3",
    "zod": "4.1.12",
    "bits-ui": "2.14.4",
    "clsx": "2.1.1",
    "tailwind-merge": "3.3.1",
    "class-variance-authority": "0.7.1",
    "tailwindcss": "4.1.17",
    "@tailwindcss/vite": "4.1.17"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@types/bun": "1.3.2",
    "typescript": "5.9.3",
    "svelte-check": "4.3.3"
  }
}
